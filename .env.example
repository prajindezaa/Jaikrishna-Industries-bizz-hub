# ==============================================================================
# Jaikrishna Industries — Environment Variables Example
# Copy this file to .env.local and fill in your real credentials.
# NEVER commit .env.local to Git.
# This file must ONLY contain empty placeholder values — never real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Canonical Domain Configuration (Single source of truth)
# ------------------------------------------------------------------------------
APP_URL="https://jaikrishnabizzhub.in"
VITE_APP_URL="https://jaikrishnabizzhub.in"

# ------------------------------------------------------------------------------
# 1. Firebase Web Client Configuration (PUBLIC — Embedded in browser bundle)
# Source: Firebase Console > Project Settings > General > Your apps > Web app
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
# For custom domain proxying use jaikrishnabizzhub.in (or default jaikrishna-industries.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN="jaikrishnabizzhub.in"
VITE_FIREBASE_PROJECT_ID="jaikrishna-industries"
VITE_FIREBASE_STORAGE_BUCKET="jaikrishna-industries.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
# Optional Web Push VAPID key: Firebase Console > Project Settings > Cloud Messaging > Web configuration > Generate key pair
VITE_FIREBASE_VAPID_KEY=""

# ------------------------------------------------------------------------------
# 2. Google Gemini API (SECRET — Server-side only, NEVER use VITE_ prefix)
# Source: Google AI Studio (https://aistudio.google.com/apikey) - Paid/Billing tier required
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (SECRET — Server-side only, for verifying team auth tokens)
# Source: Firebase Console > Project Settings > Service accounts > Generate new private key
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="jaikrishna-industries"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# ------------------------------------------------------------------------------
# 4. Resend Email Service (SECRET — Server & Cloud Functions only)
# Source: Resend Dashboard (https://resend.com/api-keys)
# ------------------------------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="reminders@jaikrishnaindustries.com"

# ------------------------------------------------------------------------------
# 5. Cloudinary Image Storage (Cloud Name is PUBLIC, API Key/Secret are SECRET)
# Source: Cloudinary Dashboard (https://cloudinary.com/console)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME="jaikrishna"
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ------------------------------------------------------------------------------
# 6. Server Configuration (Local Development)
# ------------------------------------------------------------------------------
PORT="3000"
NODE_ENV="development"
