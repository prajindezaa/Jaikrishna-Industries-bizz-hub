rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function currentUserEmail() {
      return request.auth.token.email.lower();
    }

    function isInitialAdmin() {
      return isAuthenticated() && currentUserEmail() == 'prajindezaa142@gmail.com';
    }

    function isAllowedMember() {
      return isAuthenticated() && (
        currentUserEmail() == 'prajindezaa142@gmail.com' ||
        exists(/databases/$(database)/documents/allowed_emails/$(currentUserEmail()))
      );
    }

    // Allowed Emails collection:
    // Any allowed member can read the list. Initial admin can create/update.
    // Allowed members can manage up to 3 member emails.
    match /allowed_emails/{emailId} {
      allow read: if isAllowedMember() || (isAuthenticated() && currentUserEmail() == emailId);
      allow create, update, delete: if isAllowedMember();
    }

    // Team members directory
    match /team_members/{memberId} {
      allow read: if isAllowedMember();
      allow write: if isAllowedMember();
    }

    // Customers CRM module: enforce lastWriteSource and updatedBy on writes from client
    match /customers/{customerId} {
      allow read: if isAllowedMember();
      allow create: if isAllowedMember() && 
        ('updatedBy' in request.resource.data) &&
        ('lastWriteSource' in request.resource.data) &&
        (request.resource.data.lastWriteSource in ['manual_edit', 'manual_create', 'bulk_import', 'bulk_stage_change']);
      allow update: if isAllowedMember() && 
        ('updatedBy' in request.resource.data) &&
        ('lastWriteSource' in request.resource.data) &&
        (request.resource.data.lastWriteSource in ['manual_edit', 'manual_create', 'bulk_import', 'bulk_stage_change']);
      allow delete: if isAllowedMember();
    }

    // Tasks & Follow-ups module: allowlisted members can manage tasks,
    // but clients CANNOT forge automation markers (automationKey, automationRuleId, automationRunId, isAutomation, createdBy: 'automation').
    match /tasks/{taskId} {
      allow read: if isAllowedMember();
      allow create: if isAllowedMember() &&
        (!('isAutomation' in request.resource.data) || request.resource.data.isAutomation == false) &&
        (!('automationKey' in request.resource.data) || request.resource.data.automationKey == null) &&
        (!('createdBy' in request.resource.data) || request.resource.data.createdBy != 'automation');
      allow update: if isAllowedMember() &&
        // Protect automation fields from client mutation
        (!('automationKey' in request.resource.data) || request.resource.data.automationKey == resource.data.automationKey) &&
        (!('isAutomation' in request.resource.data) || request.resource.data.isAutomation == resource.data.isAutomation) &&
        (!('automationRuleId' in request.resource.data) || request.resource.data.automationRuleId == resource.data.automationRuleId);
      allow delete: if isAllowedMember();
    }

    // Planning Hub (daily/weekly/monthly goals)
    match /plans/{planId} {
      allow read, write: if isAllowedMember();
    }

    // Meta Ads Hub (Campaigns, Pipeline, Results)
    match /meta_ads/{adId} {
      allow read, write: if isAllowedMember();
    }

    // Festival & Pooja Events Calendar
    match /festival_events/{eventId} {
      allow read, write: if isAllowedMember();
    }

    // Orders & Billing module
    match /orders/{orderId} {
      allow read, write: if isAllowedMember();
    }

    // Trash & Soft-delete archive (retained for 30 days)
    match /trash/{trashId} {
      allow read, write: if isAllowedMember();
    }

    // Activity Logs audit trail (byAutomation logs can only be authored by Admin SDK)
    match /activity_logs/{logId} {
      allow read: if isAllowedMember();
      allow create: if isAllowedMember() &&
        (!('byAutomation' in request.resource.data) || request.resource.data.byAutomation == false);
      allow update, delete: if false; // immutable audit log
    }

    // Settings (company profile, pooja catalog, WhatsApp templates, notification defaults)
    match /settings/{settingId} {
      allow read, write: if isAllowedMember();
    }

    // AI Chat history
    match /ai_chats/{chatId} {
      allow read, write: if isAllowedMember();
    }

    // Notification logs & deduplication records
    match /notification_log/{logId} {
      allow read, write: if isAllowedMember();
    }

    // Saved search and filter presets
    match /saved_filters/{filterId} {
      allow read, write: if isAllowedMember();
    }

    // WhatsApp Hub
    match /whatsapp_queues/{queueId} {
      allow read, write: if isAllowedMember();
    }
    match /whatsapp_queue_items/{itemId} {
      allow read, write: if isAllowedMember();
    }

    // Automation Hub (Rules, Parameters, Run History, Pending Overflow Queue)
    // 1. Rules: Allowlisted members can read and edit rule settings
    match /automation_rules/{ruleId} {
      allow read: if isAllowedMember();
      allow write: if isAllowedMember();
    }
    // 2. Runs & Pending items: Server-only writes. Members have read-only access.
    match /automation_runs/{runId} {
      allow read: if isAllowedMember();
      allow write: if false; // Cloud Functions & Admin SDK only
    }
    match /automation_pending/{pendingId} {
      allow read: if isAllowedMember();
      allow write: if false; // Cloud Functions & Admin SDK only
    }
  }
}
